{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/og/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/link/t1/",
      "destination": "https://www.ton.com.br/checkout/cart/?productId=TONMEGA_TIER_D150&userTag=tonmega_tier&coupon=JONATHANCRISTIANO15&userAnticipation=0&utm_medium=invite_share&utm_source=revendedor",
      "permanent": false
    },
    {
      "source": "/link/t2/",
      "destination": "https://www.ton.com.br/checkout/cart/?productId=TONMEGA_TIER_D195&userTag=tonmega_tier&coupon=JONATHANCRISTIANO15&userAnticipation=0&utm_medium=invite_share&utm_source=revendedor",
      "permanent": false
    },
    {
      "source": "/link/t3/",
      "destination": "https://www.ton.com.br/checkout/cart/?productId=TONMEGA_TIER_S920&userTag=tonmega_tier&coupon=JONATHANCRISTIANO15&userAnticipation=0&utm_medium=invite_share&utm_source=revendedor",
      "permanent": false
    },
    {
      "source": "/link/t3-smart/",
      "destination": "https://www.ton.com.br/checkout/cart/?productId=TONMEGA_TIER_SMART_POS&userTag=tonmega_tier&coupon=JONATHANCRISTIANO15&userAnticipation=0&utm_medium=invite_share&utm_source=revendedor",
      "permanent": false
    },
    {
      "source": "/link/link-de-pagamento/",
      "destination": "https://www.ton.com.br/link-de-pagamento",
      "permanent": false
    },
    {
      "source": "/link/renda-extra/",
      "destination": "https://rendaextra.ton.com.br/renda-ton/",
      "permanent": false
    },
    {
      "source": "/ajuda/nao-liga-ou-sem-sinal/",
      "destination": "/ajuda/contato/",
      "permanent": true
    },
    {

---
// Marca do site: um "P" de maquininha (tela + leitor) em verde e preto. Não usa nem imita o
// logo da Ton (TN-F038 proíbe alterar a identidade dela; o site tem identidade própria).
interface Props {
  invertida?: boolean;
}
const { invertida = false } = Astro.props;
---

<span class:list={['marca', { invertida }]}>
  <svg viewBox="0 0 40 40" width="34" height="34" aria-hidden="true">
    <rect width="40" height="40" rx="11" fill="#00D700"></rect>
    <rect x="11" y="8" width="18" height="24" rx="4" fill="#0B0B0B"></rect>
    <rect x="14" y="11" width="12" height="8" rx="1.5" fill="#00D700"></rect>
    <circle cx="16" cy="24" r="1.6" fill="#00D700"></circle>
    <circle cx="20" cy="24" r="1.6" fill="#00D700"></circle>
    <circle cx="24" cy="24" r="1.6" fill="#00D700"></circle>
    <rect x="15" y="28" width="10" height="1.8" rx=".9" fill="#00D700"></rect>
  </svg>
  <span class="nome">Maquininha <em>Já</em></span>
</span>

<style>
  .marca {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--ink);
  }
  .marca svg {
    flex: none;
  }
  .nome {
    font-family: var(--font-display), Georgia, serif;
    font-size: 1.55rem;
    line-height: 1;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  .invertida {
    color: var(--on-panel);
  }
</style>

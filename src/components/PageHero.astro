---
// Topo das páginas internas: rótulo, H1 e resposta curta.
import { dig } from '../lib/texto';
interface Props {
  rotulo: string;
  h1: string;
  resumo?: string;
  /** usa a coluna de texto (720px) em vez da largura cheia, alinhado com o artigo */
  estreito?: boolean;
}
const { rotulo, h1, resumo, estreito = false } = Astro.props;
---

<header class:list={['ph', estreito ? 'wrap-text' : 'wrap']}>
  <span class="chip chip-dot">{rotulo}</span>
  <h1 set:html={dig(h1)} />
  {resumo && <p class="resumo" set:html={resumo} />}
  <slot />
</header>

<style>
  .ph {
    padding-block: clamp(2rem, 5vw, 4rem) clamp(2rem, 4vw, 3rem);
    display: grid;
    gap: var(--s-5);
    justify-items: start;
  }
  h1 {
    max-width: 20ch;
  }
  .resumo {
    font-size: var(--fs-3);
    color: var(--ink-2);
    max-width: 44rem;
    margin: 0;
  }
</style>

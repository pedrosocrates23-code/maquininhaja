---
// Topo das páginas internas: rótulo, H1 em serifa grande, resposta curta e data de verificação.
import { SITE } from '../data/site';
import { dig } from '../lib/texto';
interface Props {
  rotulo: string;
  h1: string;
  resumo?: string;
  verificado?: boolean;
}
const { rotulo, h1, resumo, verificado = true } = Astro.props;
---

<header class="ph wrap">
  <span class="chip chip-dot">{rotulo}</span>
  <h1 set:html={dig(h1)} />
  {resumo && <p class="resumo" set:html={resumo} />}
  {
    verificado && (
      <p class="verif">
        Conferido nas fontes oficiais em <time datetime={SITE.verificadoEm}>{SITE.verificadoEmTexto}</time>.{' '}
        <a href="/como-testamos/">Como avaliamos</a>
      </p>
    )
  }
  <slot />
</header>

<style>
  .ph {
    padding-block: clamp(2rem, 5vw, 4rem) clamp(2rem, 4vw, 3rem);
    display: grid;
    gap: var(--s-5);
    justify-items: start;
  }
  h1 {
    font-size: var(--fs-6);
    max-width: 20ch;
  }
  .resumo {
    font-size: var(--fs-3);
    color: var(--ink-2);
    max-width: 44rem;
    margin: 0;
  }
  .verif {
    font-size: var(--fs-0);
    color: var(--muted);
    margin: 0;
  }
  .verif a {
    color: var(--muted);
  }
</style>

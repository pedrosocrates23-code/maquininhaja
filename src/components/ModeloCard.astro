---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { nomeModelo } from '../lib/texto';
interface Props {
  href: string;
  nome: string;
  tipo: string;
  apelido: string;
  preco: string;
  precoNota?: string;
  itens: string[];
  img: ImageMetadata;
  alt: string;
}
const { href, nome, tipo, apelido, preco, precoNota, itens, img, alt } = Astro.props;
---

<article class="mc">
  <a href={href} class="mc-link" aria-label={`${nome}: ver detalhes, preço e taxas`}>
    <div class="mc-img">
      <Picture
        src={img}
        alt={alt}
        formats={['avif', 'webp']}
        widths={[320, 480, 640]}
        sizes="(max-width: 640px) 78vw, 320px"
        quality={82}
        loading="lazy"
        decoding="async"
      />
    </div>
    <div class="mc-corpo">
      <span class="chip chip-line">{tipo}</span>
      <h3 class="nome-modelo" set:html={nomeModelo(nome)} />
      <p class="apelido">“{apelido}”, segundo a Ton</p>
      <p class="preco"><strong>{preco}</strong>{precoNota && <span> {precoNota}</span>}</p>
      <ul>
        {itens.map((i) => <li>{i}</li>)}
      </ul>
      <span class="ver">Ver detalhes <span aria-hidden="true">→</span></span>
    </div>
  </a>
</article>

<style>
  .mc {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius-l);
    overflow: hidden;
    transition: border-color 0.2s ease, transform 0.2s ease;
    height: 100%;
  }
  .mc:hover {
    border-color: var(--ink);
    transform: translateY(-3px);
  }
  .mc-link {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }
  .mc-img {
    background: #f6f6f1;
    aspect-ratio: 1 / 0.82;
    overflow: hidden;
  }
  /* mockup gerado na proporção exata do quadro (scripts/gerar_mockups.py): cover não corta nada */
  .mc-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .mc-corpo {
    padding: var(--s-5);
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    flex: 1;
  }
  h3 {
    font-size: 2.25rem;
    line-height: 1;
    margin-top: var(--s-2);
  }
  .apelido {
    color: var(--muted);
    font-size: var(--fs-1);
    margin: 0;
  }
  .preco {
    margin: var(--s-2) 0 0;
    font-size: var(--fs-3);
  }
  .preco span {
    font-size: var(--fs-0);
    color: var(--muted);
  }
  ul {
    margin: var(--s-2) 0 var(--s-4);
    padding: 0;
    list-style: none;
    font-size: var(--fs-1);
    color: var(--ink-2);
  }
  li {
    padding: 0.35rem 0;
    border-top: 1px solid var(--line);
  }
  .ver {
    margin-top: auto;
    font-weight: 600;
    font-size: var(--fs-1);
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
</style>

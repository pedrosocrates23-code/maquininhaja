---
import { NAV } from '../data/site';
import Marca from './Marca.astro';

interface Props {
  /** transparente e em branco por cima do banner do topo; volta ao normal quando o banner sai da tela */
  sobreImagem?: boolean;
}
const { sobreImagem = false } = Astro.props;

const atual = Astro.url.pathname;
const ativo = (href: string) =>
  href === '/' ? atual === '/' : atual === href || (atual.startsWith(href) && !NAV.some((n) => n.href !== href && n.href.startsWith(href) && atual.startsWith(n.href)));
---

<header class:list={['topo', { sobre: sobreImagem }]}>
  <div class="wrap topo-in">
    <a class="logo" href="/" aria-label="Maquininha Já, página inicial">
      <Marca />
    </a>

    <nav class="nav-desk" aria-label="Principal">
      <ul>
        {
          NAV.map((n) => (
            <li>
              <a href={n.href} aria-current={ativo(n.href) ? 'page' : undefined}>
                {n.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="acoes">
      <a class="btn btn-primary btn-topo" href="/modelos/">Escolher maquininha</a>
      <button class="menu-btn" type="button" popovertarget="menu" aria-label="Abrir menu">
        <svg viewBox="0 0 24 24" aria-hidden="true" width="24" height="24"
          ><path d="M3 7h18M3 12h18M3 17h18" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg
        >
      </button>
    </div>
  </div>

  <div id="menu" popover class="menu-mob">
    <div class="menu-topo">
      <Marca />
      <button type="button" popovertarget="menu" popovertargetaction="hide" class="menu-btn" aria-label="Fechar menu">
        <svg viewBox="0 0 24 24" aria-hidden="true" width="24" height="24"
          ><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg
        >
      </button>
    </div>
    <nav aria-label="Menu móvel">
      <ul>
        {
          NAV.map((n) => (
            <li>
              <a href={n.href}>{n.label}</a>
            </li>
          ))
        }
        <li><a href="/renda-extra/">Renda Extra Ton</a></li>
        <li><a href="/transparencia/">Transparência</a></li>
      </ul>
    </nav>
    <a class="btn btn-primary" href="/modelos/">Escolher maquininha</a>
  </div>
</header>

<script>
  // Header sobre o banner: fica transparente enquanto o banner (.hero) está sob ele.
  const topo = document.querySelector<HTMLElement>('.topo.sobre');
  const hero = document.querySelector('.hero');
  if (topo && hero) {
    const obs = new IntersectionObserver(([e]) => topo.classList.toggle('rolou', !e.isIntersecting), {
      rootMargin: `-${topo.offsetHeight}px 0px 0px 0px`,
    });
    obs.observe(hero);
  }
</script>

<style>
  .topo {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: saturate(1.4) blur(12px);
    -webkit-backdrop-filter: saturate(1.4) blur(12px);
    border-bottom: 1px solid var(--line);
  }
  .topo-in {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-5);
    min-height: 68px;
  }
  .logo {
    text-decoration: none;
    color: var(--ink);
    flex: none;
  }
  .nav-desk ul {
    display: flex;
    gap: var(--s-1);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav-desk a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 0.9rem;
    border-radius: var(--pill);
    text-decoration: none;
    font-size: var(--fs-1);
    font-weight: 500;
    color: var(--ink-2);
  }
  .nav-desk a:hover,
  .nav-desk a[aria-current='page'] {
    background: var(--bg-2);
    color: var(--ink);
  }
  .acoes {
    display: flex;
    align-items: center;
    gap: var(--s-2);
  }
  .menu-btn {
    display: none;
    width: 48px;
    height: 48px;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    background: var(--paper);
    color: var(--ink);
    cursor: pointer;
  }
  .menu-mob {
    inset: 0;
    width: 100%;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    border: 0;
    padding: var(--s-4) var(--gutter) var(--s-7);
    background: var(--bg);
    color: var(--ink);
  }
  .menu-mob:popover-open {
    display: flex;
    flex-direction: column;
    gap: var(--s-6);
  }
  .menu-topo {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .menu-mob ul {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .menu-mob li a {
    display: block;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--line);
    font-family: var(--font-sans), system-ui, sans-serif;
    font-size: 2rem;
    line-height: 1.1;
    text-decoration: none;
  }

  /* Sobre o banner: sem fundo, letras brancas, e não ocupa espaço (o banner começa atrás dele). */
  .topo.sobre {
    margin-bottom: -69px;
    transition: background-color 0.25s ease, border-color 0.25s ease;
  }
  .topo.sobre:not(.rolou) {
    background: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    border-bottom-color: rgb(255 255 255 / 0.14);
  }
  .topo.sobre:not(.rolou) .logo,
  .topo.sobre:not(.rolou) .logo :global(.marca) {
    color: #fff;
  }
  .topo.sobre:not(.rolou) .nav-desk a {
    color: rgb(255 255 255 / 0.86);
  }
  .topo.sobre:not(.rolou) .nav-desk a:hover,
  .topo.sobre:not(.rolou) .nav-desk a[aria-current='page'] {
    background: rgb(255 255 255 / 0.12);
    color: #fff;
  }
  .topo.sobre:not(.rolou) .menu-btn {
    background: transparent;
    border-color: rgb(255 255 255 / 0.4);
    color: #fff;
  }

  @media (max-width: 960px) {
    .nav-desk {
      display: none;
    }
    .menu-btn {
      display: inline-flex;
    }
  }
  @media (max-width: 560px) {
    .btn-topo {
      display: none;
    }
  }
</style>

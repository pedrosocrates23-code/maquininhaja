---
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import ListaPaginas from '../../components/ListaPaginas.astro';
import Callout from '../../components/Callout.astro';
import Fontes from '../../components/Fontes.astro';
import { SITE } from '../../data/site';
import { IMG } from '../../lib/imagens';
import { getCollection } from 'astro:content';
import { pagina, ID, imagemOg } from '../../lib/schema';

const title = 'Dúvidas antes de pedir a maquininha Ton';
const description =
  'O que acontece depois do pedido, como cancelar e devolver, e os canais oficiais da Ton para quem já é cliente. Site independente, Parceiro Ton.';
const path = '/ajuda/';
const crumbs = [
  { name: 'Início', href: '/' },
  { name: 'Ajuda', href: path },
];
const ORDEM = ['ajuda/primeiros-passos', 'ajuda/cancelar-e-devolver', 'ajuda/contato'];
// Spokes do cluster na ordem da lista visível (o resto vem depois, por data, como em ListaPaginas).
const spokes = (await getCollection('paginas', (p) => p.data.secao === 'ajuda' && !p.data.draft && !p.data.noindex))
  .sort((a, b) => {
    const ia = ORDEM.indexOf(a.id);
    const ib = ORDEM.indexOf(b.id);
    if (ia !== -1 || ib !== -1) return (ia === -1 ? 99 : ia) - (ib === -1 ? 99 : ib);
    return b.data.atualizado.getTime() - a.data.atualizado.getTime();
  })
  .map((p) => `/${p.id}/`);
const schema = pagina({
  path, title, description, tipo: 'CollectionPage',
  atualizado: SITE.verificadoEm, revisado: SITE.verificadoEm, crumbs,
  sobre: [ID.ton], partes: spokes, mencoes: ['maquininha'], imagem: imagemOg('ajuda'),
});
---

<Base title={title} description={description} crumbs={crumbs} schema={schema} ogImage="/og/ajuda.jpg" atualizado={SITE.verificadoEm}>
  <PageHero
    rotulo="Ajuda"
    h1="Dúvidas antes de pedir a maquininha Ton"
    resumo="O que acontece depois do pedido e o que fazer se você desistir, respondido com a fonte oficial. Já é cliente da Ton? O atendimento é da Ton, pelos canais oficiais."
   
  />
  <div class="wrap hub">
    <div>
      <Callout tipo="atencao" titulo="Já é cliente? Fale direto com a Ton">
        <p>
          Máquina que não liga, erro na tela, conta bloqueada ou dinheiro retido: quem resolve é a Ton. Não vemos sua
          conta, sua máquina nem suas vendas. Use o WhatsApp oficial (11) 3004-9136 ou o chat do app. Todos os
          <a href="/ajuda/contato/">canais oficiais</a> estão na página de contato.
        </p>
      </Callout>
      <div class="decidir" data-secao="ajuda_decisao">
        <p class="decidir-t">Ainda não pediu? Resolva a escolha primeiro.</p>
        <div class="decidir-bt">
          <a class="btn btn-primary" href="/modelos/" data-evento="ajuda_ver_modelos">Ver os 4 modelos</a>
          <a class="btn btn-ghost" href="/quanto-custa/calculadora/" data-evento="ajuda_simular">Simular minhas taxas</a>
        </div>
      </div>
      <div class="lista">
        <ListaPaginas
          secao="ajuda"
          ordem={ORDEM}
        />
      </div>
    </div>
    <figure class="img">
      <Picture src={IMG.ajuda} alt="Mãos seguram uma maquininha Ton T3 verde com um QR Code Pix na tela, ao lado de um celular, sobre um balcão" formats={['avif', 'webp']} widths={[400, 600, 800]} sizes="(max-width: 900px) 92vw, 420px" quality={60} loading="lazy" />
    </figure>
  </div>
  <div class="wrap">
    <Fontes ids={['TN-F094']} />
  </div>
</Base>

<style>
  .hub {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    padding-bottom: var(--s-9);
    align-items: start;
  }
  .lista {
    margin-top: var(--s-6);
  }
  .decidir {
    margin-top: var(--s-5);
    display: grid;
    gap: var(--s-3);
  }
  .decidir-t {
    margin: 0;
    font-weight: 700;
  }
  .decidir-bt {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
  }
  .img {
    margin: 0;
    position: sticky;
    top: 6rem;
  }
  .img :global(img) {
    border-radius: var(--radius-l);
    aspect-ratio: 3 / 4;
    object-fit: cover;
    width: 100%;
  }
  @media (max-width: 900px) {
    .hub {
      grid-template-columns: 1fr;
    }
    .img {
      display: none;
    }
  }
</style>

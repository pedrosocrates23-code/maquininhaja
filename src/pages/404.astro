---
import Base from '../layouts/Base.astro';
---

<Base title="Página não encontrada" description="Esta página não existe ou mudou de endereço. Volte para os modelos, as taxas ou a ajuda da maquininha Ton." noindex>
  <section class="wrap nf">
    <span class="chip chip-dot">Erro 404</span>
    <h1>Essa venda não passou.</h1>
    <p>A página não existe ou mudou de endereço. Tenta um destes caminhos:</p>
    <div class="acoes">
      <a class="btn btn-dark" href="/modelos/">Ver os modelos</a>
      <a class="btn btn-ghost" href="/quanto-custa/">Ver as taxas</a>
      <a class="btn btn-ghost" href="/ajuda/">Ir para a ajuda</a>
    </div>
  </section>
</Base>

<style>
  .nf {
    padding-block: clamp(4rem, 12vw, 9rem);
    display: grid;
    gap: var(--s-5);
    justify-items: start;
  }
  h1 {
    font-size: var(--fs-7);
    line-height: 0.95;
  }
  p {
    font-size: var(--fs-3);
    color: var(--ink-2);
  }
  .acoes {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
  }
</style>
